<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for Borderless MSIX. CI / Build-Msix.ps1 injects Identity + publisher from env/secrets.
  Do not commit real Partner Center Identity.Name / Publisher CN here.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="Borderless.Dev"
    Publisher="CN=BorderlessDev"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Borderless</DisplayName>
    <PublisherDisplayName>Borderless</PublisherDisplayName>
    <Description>Apply borderless and related window rules to games and apps.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Borderless"
                 Executable="Borderless.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Borderless"
        Description="Apply borderless and related window rules to games and apps."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
