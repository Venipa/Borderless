<UserControl x:Class="Borderless.App.Views.RuleEditorSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Borderless.App.Localization"
             xmlns:controls="clr-namespace:Borderless.App.Controls"
             xmlns:converters="clr-namespace:Borderless.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <ui:Card Padding="0"
             BorderThickness="1,0,0,0"
             Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,20,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="{Binding DialogTitle}"
                              FontTypography="Subtitle"
                              Appearance="Primary"
                              VerticalAlignment="Center"
                              TextWrapping="Wrap" />
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           ToolTip="{loc:Loc Cancel}" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Padding="20,8,20,8"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel>
                    <ui:TextBlock Text="{loc:Loc WindowTitleLabel}"
                                  FontTypography="Caption"
                                  Appearance="Secondary"
                                  Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding WindowTitlePlaceholder}"
                                    ClearButtonEnabled="True" />
                        <controls:PillToggleButton Grid.Column="1"
                                                   IsChecked="{Binding UseTitleRegex, Mode=TwoWay}"
                                                   Width="36"
                                                   Height="36"
                                                   Margin="8,0,0,0"
                                                   Padding="0"
                                                   ToolTip="{loc:Loc ToggleTitleRegexTooltip}"
                                                   VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="BracesVariable24" FontSize="16" />
                        </controls:PillToggleButton>
                    </Grid>

                    <ui:TextBlock Text="{loc:Loc MatchConditionLabel}"
                                  FontTypography="Caption"
                                  Appearance="Secondary"
                                  Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding MatchConditionOptions}"
                              SelectedValue="{Binding MatchCondition, Mode=TwoWay}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="DisplayName"
                              ToolTip="{Binding MatchConditionToolTip}"
                              ItemContainerStyle="{StaticResource MatchConditionComboBoxItemStyle}"
                              MinHeight="32"
                              Margin="0,0,0,16" />

                    <ui:TextBlock Text="{loc:Loc ExecutableNameLabel}"
                                  FontTypography="Caption"
                                  Appearance="Secondary"
                                  Margin="0,0,0,6" />

                    <Grid x:Name="ExecutablePickerHost"
                          Margin="0,0,0,20"
                          Panel.ZIndex="20">
                        <ui:TextBox x:Name="ExecutableBox"
                                    Text="{Binding ExecutableName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:Loc ExecutableNamePlaceholder}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True"
                                    GotKeyboardFocus="OnExecutableGotFocus"
                                    PreviewMouseLeftButtonDown="OnExecutablePreviewMouseDown"
                                    LostKeyboardFocus="OnExecutableLostFocus" />
                        <Popup x:Name="ProcessPopup"
                               PlacementTarget="{Binding ElementName=ExecutableBox}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsProcessPickerOpen, Mode=TwoWay}"
                               Width="{Binding ActualWidth, ElementName=ExecutablePickerHost}">
                            <Border MaxHeight="280"
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ListBox x:Name="ProcessList"
                                         ItemsSource="{Binding FilteredProcesses}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="OnProcessListPreviewMouseLeftButtonUp"
                                         KeyboardNavigation.DirectionalNavigation="Contained"
                                         Style="{StaticResource DefaultListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <controls:HighlightTextBlock
                                                SourceText="{Binding DisplayText}"
                                                Highlight="{Binding Text, ElementName=ExecutableBox}"
                                                TextWrapping="NoWrap"
                                                Margin="0,4" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"
                                               BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <ui:TextBlock Text="{loc:Loc GroupVideo}"
                                          FontTypography="BodyStrong"
                                          Appearance="Primary"
                                          Margin="0,0,0,8" />
                            <Border Style="{StaticResource OutlinedGroupCard}" Margin="0,0,0,0">
                                <StackPanel>
                                    <controls:SwitchOptionRow Title="{loc:Loc ToggleBorderless}"
                                                              InfoTooltipEnabled="True"
                                                              InfoTooltipContent="{loc:Loc ToggleBorderlessHint}"
                                                              IsChecked="{Binding IsBorderless}" />
                                    <controls:SwitchOptionRow Title="{loc:Loc ToggleAlwaysOnTop}"
                                                              IsChecked="{Binding IsAlwaysOnTop}" />
                                    <controls:SwitchOptionRow Title="{loc:Loc ToggleExpandToScreen}"
                                                              IsChecked="{Binding IsExpandToScreen}"
                                                              IsEnabled="{Binding UseCustomDimension, Converter={StaticResource InverseBooleanConverter}}" />
                                    <controls:SwitchOptionRow Title="{loc:Loc ToggleCustomDimension}"
                                                              IsChecked="{Binding UseCustomDimension}"
                                                              IsEnabled="{Binding IsExpandToScreen, Converter={StaticResource InverseBooleanConverter}}"
                                                              Margin="0" />
                                    <Grid Margin="0,10,0,0"
                                          Visibility="{Binding UseCustomDimension, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="{Binding CustomDimensionSummary}"
                                                      FontTypography="Caption"
                                                      Appearance="Secondary"
                                                      VerticalAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      Margin="0,0,8,0" />
                                        <ui:Button Grid.Column="1"
                                                   Content="{loc:Loc EditDimensions}"
                                                   Appearance="Secondary"
                                                   Command="{Binding EditDimensionDialogCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <ui:TextBlock Text="{loc:Loc GroupInput}"
                                          FontTypography="BodyStrong"
                                          Appearance="Primary"
                                          Margin="0,0,0,8" />
                            <Border Style="{StaticResource OutlinedGroupCard}" Margin="0">
                                <StackPanel>
                                    <controls:SwitchOptionRow Title="{loc:Loc ToggleLockCursor}"
                                                              Description="{loc:Loc ToggleLockCursorHint}"
                                                              IsChecked="{Binding LockCursor}" />
                                    <controls:SwitchOptionRow Title="{loc:Loc ToggleHideCursor}"
                                                              Description="{loc:Loc ToggleHideCursorHint}"
                                                              IsChecked="{Binding HideCursor}" />
                                    <controls:SwitchOptionRow Title="{loc:Loc ToggleRemoveGameMenus}"
                                                              Description="{loc:Loc ToggleRemoveGameMenusHint}"
                                                              IsChecked="{Binding RemoveGameMenus}"
                                                              Margin="0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,16,0,0">
                            <ui:TextBlock Text="{loc:Loc GroupAudio}"
                                          FontTypography="BodyStrong"
                                          Appearance="Primary"
                                          Margin="0,0,0,8" />
                            <Border Style="{StaticResource OutlinedGroupCard}" Margin="0">
                                <controls:SwitchOptionRow Title="{loc:Loc ToggleMuteBackground}"
                                                          IsChecked="{Binding MuteInBackground}"
                                                          Margin="0" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#FFFF6B6B"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,12,20,20">
                <controls:PillToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                           Content="{Binding EnabledToggleLabel}"
                                           Width="168"
                                           Height="36"
                                           VerticalAlignment="Center" />

                <Line X1="0"
                      Y1="0"
                      X2="0"
                      Y2="1"
                      Stretch="Fill"
                      Width="1"
                      Height="36"
                      Margin="12,0"
                      VerticalAlignment="Center"
                      Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                      StrokeThickness="1"
                      StrokeDashArray="1 2"
                      SnapsToDevicePixels="True" />

                <ui:Button Content="{loc:Loc Cancel}"
                           Appearance="Secondary"
                           Height="36"
                           MinHeight="36"
                           Padding="14,0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <ui:Button Content="{loc:Loc Save}"
                           Appearance="Primary"
                           Height="36"
                           MinHeight="36"
                           Padding="14,0"
                           VerticalAlignment="Center"
                           Command="{Binding DataContext.SaveEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <!-- Custom dimension dialog overlay -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="3"
                  Panel.ZIndex="50"
                  Background="#99000000"
                  Visibility="{Binding IsDimensionDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="360"
                        MaxWidth="420"
                        Margin="24"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Loc CustomDimensionDialogTitle}"
                                      FontTypography="Subtitle"
                                      Appearance="Primary"
                                      Margin="0,0,0,6" />
                        <ui:TextBlock Text="{loc:Loc CustomDimensionDialogSubtitle}"
                                      FontTypography="Caption"
                                      Appearance="Secondary"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="{loc:Loc DimensionX}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftX, UpdateSourceTrigger=PropertyChanged}"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="{loc:Loc DimensionY}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftY, UpdateSourceTrigger=PropertyChanged}"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="{loc:Loc DimensionWidth}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftWidth, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="{loc:Loc DimensionHeight}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftHeight, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="{loc:Loc Cancel}"
                                       Appearance="Secondary"
                                       Margin="0,0,8,0"
                                       Command="{Binding CancelDimensionDialogCommand}" />
                            <ui:Button Content="{loc:Loc Save}"
                                       Appearance="Primary"
                                       Command="{Binding SaveDimensionDialogCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ui:Card>
</UserControl>
