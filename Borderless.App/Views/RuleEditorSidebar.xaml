<UserControl x:Class="Borderless.App.Views.RuleEditorSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Borderless.App.Localization"
             xmlns:controls="clr-namespace:Borderless.App.Controls"
             xmlns:converters="clr-namespace:Borderless.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <ui:Card Padding="0"
             BorderThickness="1,0,0,0"
             Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,20,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="{Binding DialogTitle}"
                              FontTypography="Subtitle"
                              Appearance="Primary"
                              VerticalAlignment="Center"
                              TextWrapping="Wrap" />
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           ToolTip="{loc:Loc Cancel}" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Padding="20,8,20,8"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel>
                    <ui:TextBlock Text="{loc:Loc WindowTitleLabel}"
                                  FontTypography="Caption"
                                  Appearance="Secondary"
                                  Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{loc:Loc WindowTitlePlaceholder}"
                                Margin="0,0,0,16" />

                    <ui:TextBlock Text="{loc:Loc ExecutableNameLabel}"
                                  FontTypography="Caption"
                                  Appearance="Secondary"
                                  Margin="0,0,0,6" />

                    <Grid x:Name="ExecutablePickerHost"
                          Margin="0,0,0,20"
                          Panel.ZIndex="20">
                        <ui:TextBox x:Name="ExecutableBox"
                                    Text="{Binding ExecutableName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:Loc ExecutableNamePlaceholder}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True"
                                    GotKeyboardFocus="OnExecutableGotFocus"
                                    PreviewMouseLeftButtonDown="OnExecutablePreviewMouseDown"
                                    LostKeyboardFocus="OnExecutableLostFocus" />
                        <Popup x:Name="ProcessPopup"
                               PlacementTarget="{Binding ElementName=ExecutableBox}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsProcessPickerOpen, Mode=TwoWay}"
                               Width="{Binding ActualWidth, ElementName=ExecutablePickerHost}">
                            <Border MaxHeight="280"
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ListBox x:Name="ProcessList"
                                         ItemsSource="{Binding FilteredProcesses}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="OnProcessListPreviewMouseLeftButtonUp"
                                         KeyboardNavigation.DirectionalNavigation="Contained">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <controls:HighlightTextBlock
                                                SourceText="{Binding DisplayText}"
                                                Highlight="{Binding Text, ElementName=ExecutableBox}"
                                                TextWrapping="NoWrap"
                                                Margin="0,4" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <ui:TextBlock Text="{loc:Loc GroupVideo}"
                                  FontTypography="BodyStrong"
                                  Appearance="Primary"
                                  Margin="0,0,0,8" />

                    <ui:Card Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <ui:ToggleSwitch Content="{loc:Loc ToggleBorderless}"
                                             IsChecked="{Binding IsBorderless}"
                                             Margin="0,0,0,12" />
                            <ui:ToggleSwitch Content="{loc:Loc ToggleAlwaysOnTop}"
                                             IsChecked="{Binding IsAlwaysOnTop}"
                                             Margin="0,0,0,12" />
                            <ui:ToggleSwitch Content="{loc:Loc ToggleExpandToScreen}"
                                             IsChecked="{Binding IsExpandToScreen}"
                                             IsEnabled="{Binding UseCustomDimension, Converter={StaticResource InverseBooleanConverter}}"
                                             Margin="0,0,0,12" />
                            <ui:ToggleSwitch Content="{loc:Loc ToggleCustomDimension}"
                                             IsChecked="{Binding UseCustomDimension}"
                                             IsEnabled="{Binding IsExpandToScreen, Converter={StaticResource InverseBooleanConverter}}" />
                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding UseCustomDimension, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{Binding CustomDimensionSummary}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              VerticalAlignment="Center"
                                              TextWrapping="Wrap"
                                              Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1"
                                           Content="{loc:Loc EditDimensions}"
                                           Appearance="Secondary"
                                           Command="{Binding EditDimensionDialogCommand}" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:TextBlock Text="{loc:Loc GroupAudio}"
                                  FontTypography="BodyStrong"
                                  Appearance="Primary"
                                  Margin="0,12,0,8" />

                    <ui:Card Padding="14" Margin="0,0,0,8">
                        <ui:ToggleSwitch Content="{loc:Loc ToggleMuteBackground}"
                                         IsChecked="{Binding MuteInBackground}" />
                    </ui:Card>

                    <ui:TextBlock Text="{loc:Loc GroupGeneral}"
                                  FontTypography="BodyStrong"
                                  Appearance="Primary"
                                  Margin="0,12,0,8" />

                    <ui:Card Padding="14" Margin="0,0,0,10">
                        <ui:ToggleSwitch Content="{loc:Loc ToggleRuleEnabled}"
                                         IsChecked="{Binding IsEnabled}" />
                    </ui:Card>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#FFFF6B6B"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,12,20,20">
                <ui:Button Content="{loc:Loc Cancel}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <ui:Button Content="{loc:Loc Save}"
                           Appearance="Primary"
                           Command="{Binding DataContext.SaveEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <!-- Custom dimension dialog overlay -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="3"
                  Panel.ZIndex="50"
                  Background="#99000000"
                  Visibility="{Binding IsDimensionDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="360"
                        MaxWidth="420"
                        Margin="24"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Loc CustomDimensionDialogTitle}"
                                      FontTypography="Subtitle"
                                      Appearance="Primary"
                                      Margin="0,0,0,6" />
                        <ui:TextBlock Text="{loc:Loc CustomDimensionDialogSubtitle}"
                                      FontTypography="Caption"
                                      Appearance="Secondary"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="{loc:Loc DimensionX}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftX, UpdateSourceTrigger=PropertyChanged}"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="{loc:Loc DimensionY}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftY, UpdateSourceTrigger=PropertyChanged}"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="{loc:Loc DimensionWidth}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftWidth, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="{loc:Loc DimensionHeight}"
                                              FontTypography="Caption"
                                              Appearance="Secondary"
                                              Margin="0,0,0,6" />
                                <ui:NumberBox Value="{Binding DraftHeight, UpdateSourceTrigger=PropertyChanged}"
                                              Minimum="0"
                                              SpinButtonPlacementMode="Hidden"
                                              ClearButtonEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="{loc:Loc Cancel}"
                                       Appearance="Secondary"
                                       Margin="0,0,8,0"
                                       Command="{Binding CancelDimensionDialogCommand}" />
                            <ui:Button Content="{loc:Loc Save}"
                                       Appearance="Primary"
                                       Command="{Binding SaveDimensionDialogCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ui:Card>
</UserControl>
