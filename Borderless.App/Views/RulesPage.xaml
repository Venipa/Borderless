<Page
    HorizontalAlignment="Stretch"
    ScrollViewer.CanContentScroll="False"
    VerticalAlignment="Stretch"
    x:Class="Borderless.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="clr-namespace:Borderless.App.Converters"
    xmlns:loc="clr-namespace:Borderless.App.Localization"
    xmlns:models="clr-namespace:Borderless.App.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:RuleLiveStatusToBrushConverter x:Key="RuleLiveStatusToBrushConverter" />
        <converters:RuleLiveStatusToTooltipConverter x:Key="RuleLiveStatusToTooltipConverter" />

        <Style TargetType="ui:SymbolIcon" x:Key="RuleFeatureIconStyle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style TargetType="ui:ListViewItem" x:Key="RuleListItemStyle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MaxHeight" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ListViewItem">
                        <Border
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="0"
                            SnapsToDevicePixels="True"
                            x:Name="RowBorder">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="RowBorder" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="RowBorder" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        HorizontalAlignment="Stretch"
        Margin="24,16,24,24"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,12">
            <ui:TextBlock
                Appearance="Primary"
                FontTypography="Title"
                Text="{loc:Loc ProcessRulesTitle}" />
            <ui:TextBlock
                Appearance="Secondary"
                FontTypography="Caption"
                Margin="0,4,0,0"
                Text="{loc:Loc ProcessRulesSubtitle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ui:TextBox
            ClearButtonEnabled="True"
            Grid.Row="1"
            Icon="{ui:SymbolIcon Search24}"
            Margin="0,0,0,12"
            PlaceholderText="{loc:Loc SearchRulesPlaceholder}"
            Text="{Binding RulesSearchText, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding HasRules, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border
            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
            Grid.Row="2"
            Height="1"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,8"
            SnapsToDevicePixels="True"
            Visibility="{Binding HasRules, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="3" HorizontalAlignment="Stretch">
            <ui:ListView
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                ItemContainerStyle="{StaticResource RuleListItemStyle}"
                ItemsSource="{Binding FilteredRules}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedRule}"
                VerticalAlignment="Stretch"
                Visibility="{Binding HasVisibleRules, Converter={StaticResource BooleanToVisibilityConverter}}"
                x:Name="RulesList">
                <ui:ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ProcessRule}">
                        <Grid
                            Background="Transparent"
                            Cursor="Hand"
                            Height="48"
                            MouseLeftButtonUp="OnEditRuleClick"
                            Tag="{Binding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Status pill (enabled) or disabled icon  -->
                            <Grid
                                Grid.Column="0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Width="16">
                                <Border
                                    Background="{Binding LiveStatus, Converter={StaticResource RuleLiveStatusToBrushConverter}}"
                                    CornerRadius="1.5"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    ToolTip="{Binding LiveStatus, Converter={StaticResource RuleLiveStatusToTooltipConverter}}"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Width="3" />
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                    HorizontalAlignment="Center"
                                    Symbol="Prohibited24"
                                    ToolTip="{loc:Loc RuleStatusDisabled}"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                            <Grid
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock
                                    Appearance="Primary"
                                    FontTypography="Body"
                                    Grid.Row="0"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Grid.Row="1"
                                    Margin="0,1,0,0"
                                    TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ExecutableName, Mode=OneWay, TargetNullValue=—}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding WindowTitle, Mode=OneWay, TargetNullValue=—}" />
                                </TextBlock>
                            </Grid>

                            <StackPanel
                                Grid.Column="2"
                                Margin="0,0,4,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <ui:SymbolIcon
                                    Style="{StaticResource RuleFeatureIconStyle}"
                                    Symbol="DesktopPulse24"
                                    ToolTip="{loc:Loc BadgeBorderless}"
                                    Visibility="{Binding IsBorderless, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon
                                    Style="{StaticResource RuleFeatureIconStyle}"
                                    Symbol="Pin24"
                                    ToolTip="{loc:Loc BadgeAlwaysOnTop}"
                                    Visibility="{Binding IsAlwaysOnTop, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon
                                    Style="{StaticResource RuleFeatureIconStyle}"
                                    Symbol="FullScreenMaximize24"
                                    ToolTip="{loc:Loc BadgeExpandToScreen}"
                                    Visibility="{Binding IsExpandToScreen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon
                                    Style="{StaticResource RuleFeatureIconStyle}"
                                    Symbol="SpeakerMute24"
                                    ToolTip="{loc:Loc BadgeMuteBackground}"
                                    Visibility="{Binding MuteInBackground, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon
                                    Style="{StaticResource RuleFeatureIconStyle}"
                                    Symbol="LockClosed24"
                                    ToolTip="{loc:Loc BadgeLockCursor}"
                                    Visibility="{Binding LockCursor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon
                                    Style="{StaticResource RuleFeatureIconStyle}"
                                    Symbol="CursorHoverOff24"
                                    ToolTip="{loc:Loc BadgeHideCursor}"
                                    Visibility="{Binding HideCursor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon
                                    Style="{StaticResource RuleFeatureIconStyle}"
                                    Symbol="TextBulletListSquare24"
                                    ToolTip="{loc:Loc BadgeRemoveGameMenus}"
                                    Visibility="{Binding RemoveGameMenus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <ui:Button
                                Appearance="Transparent"
                                Click="OnDeleteRuleClick"
                                Grid.Column="3"
                                Height="28"
                                Icon="{ui:SymbolIcon Delete24}"
                                Margin="0,0,6,0"
                                Padding="0"
                                Tag="{Binding}"
                                ToolTip="{loc:Loc DeleteRuleTooltip}"
                                VerticalAlignment="Center"
                                Width="28" />
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <StackPanel
                HorizontalAlignment="Left"
                Margin="4,16,0,0"
                VerticalAlignment="Top"
                Visibility="{Binding ShowRulesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:TextBlock
                    Appearance="Primary"
                    FontTypography="BodyStrong"
                    Text="{loc:Loc EmptyTitle}" />
                <ui:TextBlock
                    Appearance="Secondary"
                    FontTypography="Caption"
                    Margin="0,4,0,0"
                    Text="{loc:Loc EmptySubtitle}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Left"
                Margin="4,16,0,0"
                VerticalAlignment="Top"
                Visibility="{Binding ShowSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:TextBlock
                    Appearance="Primary"
                    FontTypography="BodyStrong"
                    Text="{loc:Loc SearchEmptyTitle}" />
                <ui:TextBlock
                    Appearance="Secondary"
                    FontTypography="Caption"
                    Margin="0,4,0,0"
                    Text="{loc:Loc SearchEmptySubtitle}" />
            </StackPanel>

            <ui:Button
                Appearance="Secondary"
                Click="OnAddRuleClick"
                CornerRadius="12"
                FontSize="20"
                Height="52"
                HorizontalAlignment="Right"
                Icon="{ui:SymbolIcon Add24}"
                Margin="0,0,4,4"
                ToolTip="{loc:Loc AddRuleTooltip}"
                VerticalAlignment="Bottom"
                Visibility="{Binding ShowAddButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                Width="52"
                x:Name="AddRuleButton" />
        </Grid>
    </Grid>
</Page>
