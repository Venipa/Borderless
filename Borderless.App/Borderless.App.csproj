<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- Win10 TFM enables PackageManager / Store WinRT APIs for MSIX updates. -->
        <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Resources\app.ico</ApplicationIcon>
        <NeutralLanguage>en</NeutralLanguage>
        <AssemblyName>Borderless</AssemblyName>
        <RootNamespace>Borderless.App</RootNamespace>
        <Product>Borderless</Product>
        <Authors>Venipa</Authors>
        <Company>Venipa</Company>
        <Copyright>Copyright (c) Venipa</Copyright>
        <!-- GitHub (default) | Store — drives DISTRIBUTION_* defines and updater path. -->
        <Distribution Condition="'$(Distribution)' == ''">GitHub</Distribution>
        <!-- Overridden by CI from github.repository -->
        <GitHubRepository Condition="'$(GitHubRepository)' == ''">Venipa/Borderless</GitHubRepository>
        <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/$(GitHubRepository)</RepositoryUrl>
        <UpdateReleasesApiUrl Condition="'$(UpdateReleasesApiUrl)' == ''">https://api.github.com/repos/$(GitHubRepository)/releases/latest</UpdateReleasesApiUrl>
        <UpdateReleasesPageUrl Condition="'$(UpdateReleasesPageUrl)' == ''">https://github.com/$(GitHubRepository)/releases</UpdateReleasesPageUrl>
        <!-- Overridden by CI: -p:Version=1.0.0.0 from tag v1.0.0.0 -->
        <Version>0.0.0.0</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Distribution)' == 'Store'">
        <DefineConstants>$(DefineConstants);DISTRIBUTION_STORE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Distribution)' != 'Store'">
        <DefineConstants>$(DefineConstants);DISTRIBUTION_GITHUB</DefineConstants>
    </PropertyGroup>

    <Target Name="WriteVersionFile" AfterTargets="Build">
        <WriteLinesToFile File="$(TargetDir)VERSION" Lines="$(Version)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <WriteLinesToFile File="$(TargetDir)update.json" Lines="{&quot;repository&quot;:&quot;$(GitHubRepository)&quot;,&quot;releasesApiUrl&quot;:&quot;$(UpdateReleasesApiUrl)&quot;,&quot;releasesPageUrl&quot;:&quot;$(UpdateReleasesPageUrl)&quot;,&quot;repositoryUrl&quot;:&quot;$(RepositoryUrl)&quot;,&quot;distribution&quot;:&quot;$(Distribution)&quot;}" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="WriteVersionFileOnPublish" AfterTargets="Publish">
        <WriteLinesToFile File="$(PublishDir)VERSION" Lines="$(Version)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <WriteLinesToFile File="$(PublishDir)update.json" Lines="{&quot;repository&quot;:&quot;$(GitHubRepository)&quot;,&quot;releasesApiUrl&quot;:&quot;$(UpdateReleasesApiUrl)&quot;,&quot;releasesPageUrl&quot;:&quot;$(UpdateReleasesPageUrl)&quot;,&quot;repositoryUrl&quot;:&quot;$(RepositoryUrl)&quot;,&quot;distribution&quot;:&quot;$(Distribution)&quot;}" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="TaskScheduler" Version="2.12.2" />
      <PackageReference Include="WPF-UI" Version="4.3.0" />
      <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Resources\Iconx*.png" />
      <Resource Include="Resources\app.ico" />
    </ItemGroup>

</Project>
