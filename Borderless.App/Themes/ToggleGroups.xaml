<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="OutlinedGroupCard" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- Fluent ComboBox items with option tooltips (MatchConditionOption.FormattedToolTip). -->
    <Style x:Key="MatchConditionComboBoxItemStyle"
           TargetType="ComboBoxItem"
           BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="ToolTip" Value="{Binding FormattedToolTip}" />
    </Style>
</ResourceDictionary>
