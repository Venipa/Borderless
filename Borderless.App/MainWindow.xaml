<ui:FluentWindow x:Class="Borderless.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:loc="clr-namespace:Borderless.App.Localization"
        xmlns:views="clr-namespace:Borderless.App.Views"
        mc:Ignorable="d"
        Title="{loc:Loc AppTitle}"
        Icon="pack://application:,,,/Resources/Iconx256.png"
        Width="1024"
        Height="680"
        MinWidth="800"
        MinHeight="520"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Closing="OnWindowClosing">

    <Grid>
        <tray:NotifyIcon x:Name="AppTrayIcon"
                         TooltipText="{loc:Loc AppTitle}"
                         Icon="pack://application:,,,/Resources/Iconx24.png"
                         FocusOnLeftClick="False"
                         MenuOnRightClick="True"
                         LeftClick="OnTrayLeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu Opened="OnTrayMenuOpened">
                    <MenuItem x:Name="TrayToggleMenuItem"
                              Click="OnTrayToggleClick" />
                    <Separator />
                    <MenuItem Header="{loc:Loc TrayQuit}"
                              Click="OnTrayQuitClick" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:NavigationView x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="False"
                           OpenPaneLength="220"
                           CompactPaneLength="40"
                           PaneTitle=""
                           TitleBar="{Binding ElementName=TitleBar}"
                           FrameMargin="0"
                           TransitionDuration="0"
                           Navigated="OnNavigated"
                           PaneOpened="OnPaneOpened"
                           PaneClosed="OnPaneClosed"
                           Loaded="OnNavigationLoaded">
            <ui:NavigationView.Resources>
                <Style TargetType="ui:NavigationViewItemSeparator">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="12,8" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ui:NavigationViewItemSeparator">
                                <Border Height="{TemplateBinding Height}"
                                        Margin="{TemplateBinding Margin}"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ui:NavigationView.Resources>

            <!--
              Own content host over NavigationView's built-in presenter.
              Pages are moved here after Navigate so DynamicScrollViewer never owns them.
            -->
            <ui:NavigationView.ContentOverlay>
                <ContentControl x:Name="ContentHost"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="{DynamicResource NavigationViewContentBackground}" />
            </ui:NavigationView.ContentOverlay>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Loc NavRules}"
                                       Icon="{ui:SymbolIcon DesktopPulse24}"
                                       TargetPageType="{x:Type views:RulesPage}" />
                <ui:NavigationViewItem Content="{loc:Loc NavDefaults}"
                                       Icon="{ui:SymbolIcon Options24}"
                                       TargetPageType="{x:Type views:DefaultsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="{loc:Loc NavSettings}"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Overlay caption buttons only -->
        <ui:TitleBar x:Name="TitleBar"
                     Title=""
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True"
                     Background="Transparent"
                     Height="48"
                     MinHeight="48"
                     VerticalAlignment="Top"
                     Panel.ZIndex="100" />

        <Grid x:Name="EditorOverlay"
              Panel.ZIndex="200"
              Visibility="Collapsed">
            <Border x:Name="EditorScrim"
                    Background="#99000000"
                    IsHitTestVisible="True"
                    MouseLeftButtonDown="OnEditorScrimClick" />

            <Border x:Name="EditorSidebarHost"
                    Width="520"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1,0,0,0"
                    IsHitTestVisible="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="EditorSidebarTransform" X="520" />
                </Border.RenderTransform>
                <views:RuleEditorSidebar DataContext="{Binding Editor}" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
